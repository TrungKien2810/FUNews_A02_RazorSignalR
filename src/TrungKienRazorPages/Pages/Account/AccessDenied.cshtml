@page
@model TrungKienRazorPages.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}
<div class="page-head">
    <div class="page-head__text">
        <p class="eyebrow mb-1">Account</p>
        <h1>Access denied</h1>
    </div>
</div>

<div class="state card">
    <p class="state__title">That area is not open to your role</p>
    <p class="state__body">Your account is signed in, but it does not have permission for that screen. Administrators manage accounts and reports; staff manage news and categories. If you expected access here, ask an administrator to check your role.</p>
    <div class="state__actions">
        <a class="btn btn-primary" asp-page="/Home">Go to my start page</a>
        <a class="btn btn-outline-secondary" asp-page="/News/Index">Browse news</a>
    </div>
</div>
