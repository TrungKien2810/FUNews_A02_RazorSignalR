@page "{id}"
@model TrungKienRazorPages.Pages.News.DetailsModel
@using TrungKienRazorPages.Infrastructure
@{
    var article = Model.Article;
    var categoryName = article.Category?.CategoryName ?? "Uncategorised";
    var published = article.CreatedDate;
    var isFresh = published.HasValue && (DateTime.Now - published.Value).TotalDays <= 7;

    ViewData["Title"] = article.NewsTitle;
    ViewData["Description"] = string.IsNullOrWhiteSpace(article.Headline) ? article.NewsTitle : article.Headline;
    ViewData["OgType"] = "article";
}
<div class="article-column">
<nav aria-label="Breadcrumb">
    <ol class="breadcrumb mt-4 mb-0">
        <li class="breadcrumb-item"><a asp-page="/News/Index">News</a></li>
        <li class="breadcrumb-item active" aria-current="page">@categoryName</li>
    </ol>
</nav>

<div id="news-deleted-alert" class="alert alert-warning d-none mt-3" role="alert">
    This article was deleted by a colleague while you were reading it.
</div>

<article data-news-id="@article.NewsArticleId">
    <header class="article-head">
        <p class="eyebrow mb-1">
            @categoryName
            @if (article.NewsStatus == false)
            {
                <span class="badge badge-status--draft ms-2">Draft</span>
            }
        </p>
        <h1 class="article-head__title">@article.NewsTitle</h1>
        <p class="article-head__standfirst">@article.Headline</p>
        <div class="article-meta">
            <span>By <strong>@(article.CreatedBy?.AccountName ?? "Unknown")</strong></span>
            @if (published.HasValue)
            {
                <time datetime="@published.Value.ToString("o")">@published.Value.ToString(isFresh ? "dd MMMM yyyy, HH:mm" : "dd MMMM yyyy")</time>
            }
            <span>@ReadTime.Minutes(article.NewsContent) min read</span>
            @if (article.ModifiedDate.HasValue && article.ModifiedDate != published)
            {
                <span>Updated <time datetime="@article.ModifiedDate.Value.ToString("o")">@article.ModifiedDate.Value.ToString("dd MMMM yyyy, HH:mm")</time></span>
            }
            @if (!string.IsNullOrWhiteSpace(article.NewsSource) && !article.NewsSource.Equals("N/A", StringComparison.OrdinalIgnoreCase))
            {
                <span>Source: <strong>@article.NewsSource</strong></span>
            }
        </div>
    </header>

    <div class="article-body news-content">@article.NewsContent</div>

    @if (article.Tags.Any())
    {
        <div class="tag-list mb-4">
            @foreach (var tag in article.Tags)
            {
                <a class="tag" asp-page="/News/Index" asp-route-tagId="@tag.TagId">@tag.TagName</a>
            }
        </div>
    }
</article>

@if (Model.Related.Any())
{
    <section class="related" aria-labelledby="related-title">
        <h2 class="related__title" id="related-title">More from @categoryName</h2>
        <ul class="related__list">
            @foreach (var story in Model.Related)
            {
                <li class="related__item">
                    <a class="related__link" asp-page="/News/Details" asp-route-id="@story.NewsArticleId">@story.NewsTitle</a>
                    <p class="related__meta">
                        <time datetime="@story.CreatedDate?.ToString("yyyy-MM-dd")">@story.CreatedDate?.ToString("dd MMM yyyy")</time>
                        <span aria-hidden="true">·</span>
                        <span>@ReadTime.Minutes(story.NewsContent) min read</span>
                    </p>
                </li>
            }
        </ul>
        <a class="related__more" asp-page="/News/Index" asp-route-categoryId="@article.CategoryId">See every story in @categoryName</a>
    </section>
}

<div class="d-flex gap-2 pb-5 pt-4 flex-wrap">
    <a asp-page="/News/Index" class="btn btn-outline-secondary">&larr; Back to news</a>
    <a href="#top" class="btn btn-link">Back to top</a>
</div>
</div>
