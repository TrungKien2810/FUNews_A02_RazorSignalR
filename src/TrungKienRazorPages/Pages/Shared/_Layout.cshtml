@using TrungKienRazorPages.Infrastructure
@{
    var roleName = User.IsInRole(AccountRoles.AdminName) ? AccountRoles.AdminName
                 : User.IsInRole(AccountRoles.StaffName) ? AccountRoles.StaffName
                 : AccountRoles.LecturerName;

    // Mark the current section so the active nav item is not carried by colour alone.
    var current = (ViewContext.RouteData.Values["page"] as string ?? string.Empty);
    string NavClass(string area) =>
        "app-nav__link" + (current.StartsWith(area, StringComparison.OrdinalIgnoreCase) ? " active" : string.Empty);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; FUNews</title>
    @* Script-capable marker before first paint: the menu button and the collapsed nav
       appear together instead of the nav flashing open and then closing. *@
    <script>document.documentElement.classList.add('js');</script>
    @{
        // Shared pages describe themselves; desk pages inherit the newsroom summary
        // because they sit behind a login and are never meant to be linked to.
        var description = ViewData["Description"] as string
            ?? "FUNews is the campus newsroom: stories from every department, published as they happen.";
        var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    }
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:site_name" content="FUNews" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title="FUNews — latest stories" href="~/feed.rss" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body id="top">
    <a class="sr-only" href="#main-content">Skip to content</a>

    <header class="app-bar">
        <div class="shell app-bar__inner">
            <a class="brand" asp-page="/Home">
                <span class="brand__mark" aria-hidden="true">&#9646;</span>
                <span>FUNews</span>
                <span class="brand__sub">Campus newsroom</span>
            </a>

            <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
                <span class="nav-toggle__bars" aria-hidden="true"></span>
                <span>Menu</span>
            </button>

            <nav id="site-nav" class="app-nav" aria-label="Main">
                <a class="@NavClass("/News")" asp-page="/News/Index">News</a>
                @if (User.IsInRole(AccountRoles.AdminName))
                {
                    <a class="@NavClass("/Admin/Accounts")" asp-page="/Admin/Accounts/Index">Accounts</a>
                    <a class="@NavClass("/Admin/Report")" asp-page="/Admin/Report/Index">Report</a>
                }
                @if (User.IsInRole(AccountRoles.StaffName))
                {
                    <a class="@NavClass("/Staff/News")" asp-page="/Staff/News/Index">Manage News</a>
                    <a class="@NavClass("/Staff/Categories")" asp-page="/Staff/Categories/Index">Categories</a>
                    <a class="@NavClass("/Staff/News/History")" asp-page="/Staff/News/History">My News History</a>
                    <a class="@NavClass("/Staff/Profile")" asp-page="/Staff/Profile/Index">My Profile</a>
                }
            </nav>

            <div class="app-bar__actions">
                <span id="realtime-status" class="badge badge-status--draft" role="status" aria-live="polite">Connecting&hellip;</span>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="who">
                        <span class="who__name">@User.Identity.Name</span>
                        <span class="who__role">@roleName</span>
                    </span>
                    <form asp-page="/Account/Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-light" asp-page="/Account/Login">Log in</a>
                }
            </div>
        </div>
    </header>

    <div class="shell">
        <main id="main-content" role="main">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
                    @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="shell">
            FUNewsManagementSystem &middot; &copy; @DateTime.Now.Year
            <a asp-page="/News/Index" class="ms-3">Browse news</a>
            <a asp-page="/Feed" class="ms-3">RSS feed</a>
        </div>
    </footer>

    @* Shared popup dialog used for Create / Edit / Delete / Details *@
    <div class="modal fade" id="appModal" tabindex="-1" aria-labelledby="appModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content"></div>
        </div>
    </div>

    @* Real-time notifications *@
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
