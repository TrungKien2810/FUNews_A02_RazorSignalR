@model AccountFormViewModel
<form asp-page="/Admin/Accounts/Index" asp-page-handler="@(Model.IsEdit ? "Edit" : "Create")" method="post" data-ajax-form novalidate>
    <partial name="_ModalHeader" model="@(Model.IsEdit ? "Edit account" : "Create account")" />
    <div class="modal-body">
        <div class="alert alert-danger d-none ajax-error" role="alert"></div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="AccountId" />

        @if (Model.IsEdit)
        {
            <div class="mb-3">
                <label class="form-label" for="AccountIdDisplay">Account ID</label>
                <input class="form-control" id="AccountIdDisplay" value="@Model.AccountId" disabled />
                <div class="form-text">Account IDs are assigned by the system and cannot be changed.</div>
            </div>
        }

        <div class="mb-3">
            <label asp-for="AccountName" class="form-label"></label>
            <input asp-for="AccountName" class="form-control" />
            <span asp-validation-for="AccountName"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AccountEmail" class="form-label"></label>
            <input asp-for="AccountEmail" class="form-control" autocomplete="email" />
            <span asp-validation-for="AccountEmail"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AccountRole" class="form-label"></label>
            <select asp-for="AccountRole" class="form-select">
                <option value="">Select a role</option>
                <option value="@AccountRoles.Staff">Staff</option>
                <option value="@AccountRoles.Lecturer">Lecturer</option>
            </select>
            <span asp-validation-for="AccountRole"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="AccountPassword" class="form-label"></label>
                <input asp-for="AccountPassword" class="form-control" autocomplete="new-password"
                       placeholder="@(Model.IsEdit ? "Leave blank to keep the current password" : "")" />
                <span asp-validation-for="AccountPassword"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create account")</button>
    </div>
</form>
