@model NewsFormViewModel
<form asp-page="/Staff/News/Index" asp-page-handler="@(Model.IsEdit ? "Edit" : "Create")" method="post" data-ajax-form novalidate>
    <partial name="_ModalHeader" model="@(Model.IsEdit ? "Edit news article #" + Model.NewsArticleId : "Create news article")" />
    <div class="modal-body">
        <div class="alert alert-danger d-none ajax-error" role="alert"></div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="NewsArticleId" />

        <div class="mb-3">
            <label asp-for="NewsTitle" class="form-label"></label>
            <input asp-for="NewsTitle" class="form-control" />
            <span asp-validation-for="NewsTitle"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Headline" class="form-label"></label>
            <input asp-for="Headline" class="form-control" />
            <span asp-validation-for="Headline"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewsContent" class="form-label"></label>
            <textarea asp-for="NewsContent" class="form-control" rows="7"></textarea>
            <span asp-validation-for="NewsContent"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="NewsSource" class="form-label"></label>
                <input asp-for="NewsSource" class="form-control" />
                <span asp-validation-for="NewsSource"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                    <option value="">Select a category</option>
                </select>
                <span asp-validation-for="CategoryId"></span>
            </div>
        </div>

        <fieldset class="mb-3">
            <legend class="form-label">Tags</legend>
            <div class="d-flex flex-wrap tag-list">
                @foreach (var t in Model.TagOptions)
                {
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" name="SelectedTagIds" value="@t.TagId" id="tag_@t.TagId"
                               checked="@Model.SelectedTagIds.Contains(t.TagId)" />
                        <label class="form-check-label" for="tag_@t.TagId">@t.TagName</label>
                    </div>
                }
            </div>
        </fieldset>

        <div class="form-check form-switch">
            <input asp-for="NewsStatus" class="form-check-input" role="switch" />
            <label asp-for="NewsStatus" class="form-check-label"></label>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create article")</button>
    </div>
</form>
