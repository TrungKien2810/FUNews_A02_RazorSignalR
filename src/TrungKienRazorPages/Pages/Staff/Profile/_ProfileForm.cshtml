@model ProfileViewModel
<form asp-page="/Staff/Profile/Index" asp-page-handler="Edit" method="post" data-ajax-form novalidate>
    <partial name="_ModalHeader" model="@("Edit my profile")" />
    <div class="modal-body">
        <div class="alert alert-danger d-none ajax-error" role="alert"></div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="AccountId" />

        <div class="mb-3">
            <label asp-for="AccountName" class="form-label"></label>
            <input asp-for="AccountName" class="form-control" />
            <span asp-validation-for="AccountName"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AccountEmail" class="form-label"></label>
            <input asp-for="AccountEmail" class="form-control" autocomplete="email" />
            <span asp-validation-for="AccountEmail"></span>
        </div>

        <hr />
        <p class="form-text mb-3">Leave the password fields blank to keep your current password. Changing it needs all three password fields.</p>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label"></label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>
